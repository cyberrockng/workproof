{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workproof.dev/schemas/verdict-v1.schema.json",
  "title": "VerdictV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "escrowAddress",
    "chainId",
    "jobId",
    "attempt",
    "instructionId",
    "specHash",
    "privateBundleHash",
    "artifactAddress",
    "artifactBlock",
    "artifactCodeHash",
    "randomRound",
    "randomValueHash",
    "engineVersionHash",
    "outcome",
    "passedCount",
    "executedCount",
    "reportHash",
    "issuedAt",
    "expiresAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "escrowAddress": { "$ref": "#/$defs/address" },
    "chainId": { "type": "integer", "const": 114 },
    "jobId": { "type": "string", "pattern": "^[0-9]+$" },
    "attempt": { "type": "integer", "minimum": 1 },
    "instructionId": { "$ref": "#/$defs/bytes32" },
    "specHash": { "$ref": "#/$defs/bytes32" },
    "privateBundleHash": { "$ref": "#/$defs/bytes32" },
    "artifactAddress": { "$ref": "#/$defs/address" },
    "artifactBlock": { "type": "string", "pattern": "^[0-9]+$" },
    "artifactCodeHash": { "$ref": "#/$defs/bytes32" },
    "randomRound": { "type": "string", "pattern": "^[0-9]+$" },
    "randomValueHash": { "$ref": "#/$defs/bytes32" },
    "engineVersionHash": { "$ref": "#/$defs/bytes32" },
    "outcome": { "enum": ["PASS", "FAIL", "INCONCLUSIVE"] },
    "passedCount": { "type": "integer", "minimum": 0 },
    "executedCount": { "type": "integer", "minimum": 0 },
    "reportHash": { "$ref": "#/$defs/bytes32" },
    "issuedAt": { "type": "integer", "minimum": 0 },
    "expiresAt": { "type": "integer", "minimum": 0 }
  },
  "$defs": {
    "bytes32": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
    "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" }
  }
}
