{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workproof.dev/schemas/workproof-bundle-v1.schema.json",
  "title": "WorkProofBundleV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "templateId",
    "templateVersion",
    "targetChainId",
    "publicSpecHash",
    "vectorCount",
    "selectionCount",
    "gasLimitPerCall",
    "timeoutMsPerCall",
    "maxResponseBytes",
    "vectors"
  ],
  "properties": {
    "formatVersion": { "const": 1 },
    "templateId": { "type": "string", "minLength": 1, "maxLength": 64 },
    "templateVersion": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "targetChainId": { "type": "integer", "const": 114 },
    "publicSpecHash": { "$ref": "#/$defs/bytes32" },
    "vectorCount": { "type": "integer", "minimum": 1, "maximum": 128 },
    "selectionCount": { "type": "integer", "minimum": 1, "maximum": 128 },
    "gasLimitPerCall": { "type": "integer", "minimum": 21000, "maximum": 5000000 },
    "timeoutMsPerCall": { "type": "integer", "minimum": 100, "maximum": 30000 },
    "maxResponseBytes": { "type": "integer", "minimum": 1, "maximum": 65536 },
    "vectors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/ethCallEquals" },
          { "$ref": "#/$defs/ethCallReverts" },
          { "$ref": "#/$defs/erc165SupportsInterface" },
          { "$ref": "#/$defs/codeSizeRange" },
          { "$ref": "#/$defs/storageAtEquals" }
        ]
      }
    }
  },
  "$defs": {
    "bytes": { "type": "string", "pattern": "^0x([0-9a-fA-F]{2})*$" },
    "bytes4": { "type": "string", "pattern": "^0x[0-9a-fA-F]{8}$" },
    "bytes32": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
    "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "uint256Hex": { "type": "string", "pattern": "^0x[0-9a-fA-F]{1,64}$" },
    "baseVector": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 96 },
        "type": { "type": "string" }
      }
    },
    "ethCallEquals": {
      "allOf": [
        { "$ref": "#/$defs/baseVector" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "calldata", "caller", "value", "expectedReturn"],
          "properties": {
            "id": { "type": "string" },
            "type": { "const": "ETH_CALL_EQUALS" },
            "calldata": { "$ref": "#/$defs/bytes" },
            "caller": { "$ref": "#/$defs/address" },
            "value": { "$ref": "#/$defs/uint256Hex" },
            "expectedReturn": { "$ref": "#/$defs/bytes" }
          }
        }
      ]
    },
    "ethCallReverts": {
      "allOf": [
        { "$ref": "#/$defs/baseVector" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "calldata", "caller", "value"],
          "properties": {
            "id": { "type": "string" },
            "type": { "const": "ETH_CALL_REVERTS" },
            "calldata": { "$ref": "#/$defs/bytes" },
            "caller": { "$ref": "#/$defs/address" },
            "value": { "$ref": "#/$defs/uint256Hex" },
            "expectedRevertSelector": { "$ref": "#/$defs/bytes4" },
            "expectedRevertPattern": { "type": "string", "maxLength": 128 }
          }
        }
      ]
    },
    "erc165SupportsInterface": {
      "allOf": [
        { "$ref": "#/$defs/baseVector" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "interfaceId", "expected"],
          "properties": {
            "id": { "type": "string" },
            "type": { "const": "ERC165_SUPPORTS_INTERFACE" },
            "interfaceId": { "$ref": "#/$defs/bytes4" },
            "expected": { "type": "boolean" }
          }
        }
      ]
    },
    "codeSizeRange": {
      "allOf": [
        { "$ref": "#/$defs/baseVector" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "minBytes", "maxBytes"],
          "properties": {
            "id": { "type": "string" },
            "type": { "const": "CODE_SIZE_RANGE" },
            "minBytes": { "type": "integer", "minimum": 1 },
            "maxBytes": { "type": "integer", "minimum": 1 }
          }
        }
      ]
    },
    "storageAtEquals": {
      "allOf": [
        { "$ref": "#/$defs/baseVector" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "slot", "expectedValue"],
          "properties": {
            "id": { "type": "string" },
            "type": { "const": "STORAGE_AT_EQUALS" },
            "slot": { "$ref": "#/$defs/bytes32" },
            "expectedValue": { "$ref": "#/$defs/bytes32" }
          }
        }
      ]
    }
  }
}
